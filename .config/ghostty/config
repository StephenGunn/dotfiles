# theme = Catppuccin Mocha  # Replaced by theme-switcher

# Theme colors (managed by theme-switcher)
# Generated from pywal and saved to ~/.config/ghostty/themes/pywal

background-opacity=0.95
window-padding-x=10
window-padding-y=10
window-decoration=false
font-size=15

cursor-style=block
window-save-state=always
mouse-hide-while-typing=true
shell-integration=fish
shell-integration-features=no-cursor
confirm-close-surface=false

# Clipboard settings (OSC 52 support for SSH)
copy-on-select=false
clipboard-read=allow
clipboard-write=allow
clipboard-paste-protection=false

# Font size keybindings
keybind = ctrl+equal=unbind
keybind = ctrl+plus=unbind
keybind = ctrl+shift+equal=increase_font_size:1
keybind = ctrl+minus=decrease_font_size:1
keybind = ctrl+shift+minus=reset_font_size

keybind = shift+enter=text:\n

# Theme. The fallback below is what a fresh machine gets; theme-switcher writes
# theme.conf (gitignored) and the include comes AFTER, so it wins when present.
# Order matters here — ghostty takes the last value for a scalar key.
theme = Nord
config-file = ?theme.conf

# Per-host overrides (gitignored). Anything that differs per machine — font-size
# on a high-DPI panel, say — belongs here, not in this tracked file.
config-file = ?local.conf
