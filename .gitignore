CLAUDE.md

# Dynamically generated by theme-switcher
.config/starship.toml
.config/dunst/dunstrc.d/99-colors.conf
.config/gtk-3.0/settings.ini
.config/yazi/theme.toml
.config/hypr/hosts/current.conf
.config/hypr/colors.conf
.config/nvim/lua/current-theme.lua
.config/rofi/theme.rasi
.config/current-theme
.config/quickshell/Colors.qml
.config/fish/conf.d/fish_frozen_theme.fish
.config/waypaper/style.css
.config/ghostty/theme.conf
.tmux/theme.conf

# Per-host overrides — deliberately not shared between machines
.config/ghostty/local.conf

# Machine state, not config. Rewritten constantly by fish; everything in it
# is reproduced by config.fish (EDITOR, VISUAL, paths, greeting) on a fresh
# machine. Tracking it pushed one host's PATH to all the others.
.config/fish/fish_variables

# systemctl --user enable/disable owns these. enabled_services.txt records
# which services we intend to run; the symlink farm is the result, not the
# source, and it differs per host by design.
.config/systemd/user/*.target.wants/
.config/systemd/user/*.service.wants/
# Alias symlink into /usr/lib/systemd, planted by `systemctl --user enable`
# when wireplumber takes the session-manager slot. Same class as the above.
.config/systemd/user/pipewire-session-manager.service

# ~/.local/bin is a deliberate three-script allowlist. Everything else landing
# here is a shim planted by a package manager (pipx, npm, cargo) that points
# into a per-machine venv, so ignore by default and opt scripts in explicitly.
# Adding a real script here? Add a matching `!` line or git will not see it.
.local/bin/*
!.local/bin/hypr-display-sleep
!.local/bin/rofi-power-menu
!.local/bin/theme-switch

# Per-machine, rewritten on every new SSH connection. Never share.
.ssh/known_hosts
.ssh/known_hosts.old

# Registered per-machine by the Claude Code installer.
.local/share/applications/claude-code-url-handler.desktop
